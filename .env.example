PORT=3000
COGNIGY_API_BASE_URL=https://your-cognigy-api-host.example.com
COGNIGY_API_KEY=your-api-key
COGNIGY_SEARCH_PATH=/v2.0/search
COGNIGY_QUERY_PARAM=search
COGNIGY_PROJECTS_PATH=/v2.0/projects
COGNIGY_FLOWS_PATH=/v2.0/flows
COGNIGY_STRICT_LOCAL_FILTER=false
# Optional: constrain results to one project
